{
  "schema": "controlled_studies/2",
  "name": "问题驱动的模型与管线实验",
  "requires_reference_upload": false,
  "principles": [
    "完整场景契约是输入与检查的共同来源；保留角色、外观、服装、物体、关系、构图、画风和禁止项。",
    "四个模型分别配置正负提示词、采样与权重精度；配置来源可查，不声称已是最优。",
    "默认选择完整矩阵；匹配的已完成基线可跨实验复用，人工查看后创建。只有缺少有效基线时才需单独校验配置，不自动降级。",
    "直接编辑模型文本须记录原因；中文意图不自动翻译，契约与实际英文/XML 均需审阅。",
    "全部模型、全部双向交接和同模型交接保留；完整矩阵强度与 Seed 可编辑。创建暂停，不自动开跑。"
  ],
  "studies": [
    {
      "id": "format",
      "name": "01 同一场景：统一英文与完整原生输入",
      "available": true,
      "question": "同一场景要求，以统一英文和每个模型完整适配后的输入分别生成，会获得什么、损失什么？",
      "change": "统一英文条件 vs 完整原生编译条件（含模型标签/质量条件）；可直接编辑各模型实际文本。",
      "hold": "同一模型的负面词、采样、尺寸和 Seed 固定；检查使用同一场景契约。",
      "inspect": [
        "构图/物体是否遗漏",
        "NewBie XML是否帮助对应",
        "不同表示是否引入风格变化"
      ],
      "limits": "这是两套完整输入条件的比较，不是纯标点/XML 语法实验；原生编译不等于经实测的最佳提示词。",
      "default_images": 72
    },
    {
      "id": "detail",
      "name": "02 信息增量：哪些细节值得补？",
      "available": true,
      "question": "短句省略的动作、空间和接触细节，明确补入后是否改善执行？",
      "change": "同一潜在画面意图的简略字段与详细字段。",
      "hold": "同一模型、采样、负面基线、原生编译器、画幅与 Seed；新增禁止项会显式体现在实际负面文本中。",
      "inspect": [
        "新增要求是否实际画出",
        "补词有无带来多余碎片/错误物体",
        "原本好看的风格是否受损"
      ],
      "limits": "短句未提供的细节不是模型违令；不能把人工编写补词的效果当作自动拓词已完成。美感与描述还原分别评价。",
      "default_images": 72
    },
    {
      "id": "handoff",
      "name": "03 同源图：交给谁、改多少？",
      "available": true,
      "question": "同一源图交给不同目标模型和重绘强度后，获得了什么、丢失了什么？",
      "change": "4种源模型 × 4种目标模型 × 可编辑的重绘强度；包括同模型再处理、全部双向交接。",
      "hold": "每个场景/Seed先生成四张源图，各目标直接复用对应原图；目标文本与目标采样参数固定，禁用自动修脸、手部重绘与文字擦除。",
      "inspect": [
        "与源图相比人物/画风的收益",
        "道具/关系/背景的损失",
        "是否只是抹平细节",
        "方向与强度如何影响变化"
      ],
      "limits": "这是自主迭代可用动作的受控边界实验，不是固定的最终管线。像素交接不保证角色或语义保持；各源图SHA256和全部中间版本保存。",
      "default_images": 468
    },
    {
      "id": "loops",
      "name": "04 循环交接：回来后有没有变好？",
      "available": true,
      "question": "模型回访能否同时保住优点和改善问题，还是仅累积变化？由你比较每一步并留下评价。",
      "change": "双模型 A→B→A→B 对照 A→B→B→B；含同模型重复。可切换三模型 A→B→C→A，对照 A→B→B→A。四模型均可处于任意位置。",
      "hold": "同一场景、Seed、目标模型完整文本与采样设置；每个目标的交接强度单独固定。共享前缀只生成一次，后续接收直接父版本的真实像素。",
      "inspect": ["目标问题是否改善", "原来的优点是否保留", "何时出现漂移或振荡", "最佳版本停在第几步", "多模型回访相对连续使用一个模型是否有益"],
      "limits": "这是为人类比较准备的受控多轮路径，不是看图自动决策的最终闭环。同次数不是同耗时；不同模型的强度不等效。本次冻结输入、不自动改词或局部修复。源图36张仍在新实验内生成；复用的是本次所有共享前缀和匹配基线的校验资格，不跨历史实验借用图片。",
      "default_images": 684
    },
    {
      "id": "autonomous",
      "name": "05 自主迭代：是否会正确选择下一步？",
      "available": false,
      "question": "在相同预算下，观察中间图后的动态选择能否胜过固定策略，并知道何时回退或结束？",
      "change": "决策策略；模型动作库与预算应相同。",
      "hold": "相同用户意图、模型资源、预算与结果可见范围。",
      "inspect": [
        "观察是否有图像依据",
        "动作是否对应实际问题",
        "回退与停止是否合理"
      ],
      "limits": "当前缺少接通并验证的视觉决策器与研究队列调度；暂不可创建，不以固定四候选冒充。此缺项与参考图上传功能无关。"
    }
  ],
